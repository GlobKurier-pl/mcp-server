# GlobKurier API Configuration
GLOBKURIER_API_BASE_URL=https://api.globkurier.pl
GLOBKURIER_DEFAULT_LANGUAGE=pl

# MCP Server Configuration
MCP_HOST=127.0.0.1
MCP_PORT=9000
MCP_TRANSPORT=http

# HTTP Client Configuration
HTTP_TIMEOUT=10.0

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE_PATH=  # Leave empty for console-only logging. Examples: ./logs/app.log or /var/log/globkurier-mcp/app.log
LOG_FILE_MAX_BYTES=10485760  # 10MB (only used if LOG_FILE_PATH is set)
LOG_FILE_BACKUP_COUNT=5  # Number of backup files to keep (only used if LOG_FILE_PATH is set)
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_REQUESTS=true  # Log HTTP requests/responses

# Cache Configuration
CACHE_COUNTRIES_TTL_SECONDS=604800  # 7 days (7 * 24 * 60 * 60)
